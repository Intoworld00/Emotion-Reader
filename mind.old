#include <stdio.h>
#include "repositories/mind_musics.h"
#include "repositories/mind_abreg.h"

int main() {

    char username[50];
    printf("Welcome to the Mind Reader. Please enter a username before continuing : ");
    scanf("%s", username);
    // Open file in write mode ("w" overwrites; use "a" to append)
    FILE *file = fopen("username.log", "w");
    if (file == NULL) {
        perror("Failed to open file");
        return 1;
    }

    // Write the user's input to the file
    fprintf(file, "%s\n", username);

    // Always close the file so data is saved properly
    fclose(file);

    printf("Now that i identified you, let's start with quick questions.\n");
    system("timeout /t 7 >nul");
    system("cls");
    
    // Commencer le questionnaire.
    int emotion = (sad, happy, calm, energetic, romantic);
    char country[18]; // Optional information, no impact on the mind reader.
    char sad_momQ[3];
    char okayQ[5];
    char list_rockQ[5];
    char relate_momQ[6];
    char som_FUHAQ[4];
    char calmQ[3];
    printf("\n");
    printf("Where do you come from (country) : ");
    scanf("%s", country);
    printf("\n");
    printf("Have you had a sad moment today (yes or no) : ");
    scanf("%s", sad_momQ);
    if (strcmp(sad_momQ, "yes") == 0)
    {
        emotion != happy;
        emotion != romantic;
        emotion != energetic;
        emotion = (sad, calm);
        system("timeout /t 2 >nul");
        printf("Are you okay (yes or no) : ");
        scanf("%s", okayQ);
        if (strcmp(okayQ, "no") == 0)
        {
            emotion != calm;
            emotion = sad;
            system("cls");
            printf(sad);
            system("timeout /t 6 >nul");
            printf(sadness);
            printf("timeout /t 10 >nul");
            printf("Quiting.");
            return 0;
            
        }else if (strcmp(okayQ, "yes") == 0)
        {
            emotion != romantic;
            emotion = (happy, sad, calm, energetic);
            
        }
        
        
    }
    
    printf("\n");
    printf("Do you listen to rock (yes or no): ");
    scanf("%s", list_rockQ);
    if (strcmp(list_rockQ, "yes") == 0)
    {
        emotion != sad;
        emotion != happy;
        emotion != calm;
        emotion != romantic;
        emotion = energetic;
        system("cls");
        printf(energetic);
        system("timeout /t 6 >nul");
        printf(energeticness);
        system("timeout /t 10 >nul");
        return 0;
    }
    
    printf("\n");
    printf("Have you been gone through a relationship moments, like smacks, love.. (yes or no) : ");
    scanf("%s", relate_momQ);
    if (strcmp(relate_momQ, "yes") == 0)
    {
        emotion != sad;
        emotion != happy;
        emotion != calm;
        emotion != energetic;
        emotion = romantic;
        system("cls");
        printf(romantic);
        system("timeout /t 6 >nul");
        printf(romanticness);
        system("timeout /t 10 >nul");
        return 0;
    }
    
    printf("\n");
    printf("Have you been through something funny, or something that improved you amusement (yes or no) : ");
    scanf("%s", som_FUHAQ);
    if (strcmp(som_FUHAQ, "yes") == 0)
    {
        emotion != sad;
        emotion != energetic;
        emotion != calm;
        emotion != romantic;
        emotion = happy;
        system("cls");
        printf(happy);
        system("timeout /t 6 >nul");
        printf(happiness);
        system("timeout /t 10 >nul");
        return 0;
    }
    printf("\n");
    printf("Are you sitting somewhere with no noises, or are you comfortable on your chair or listening music and working, or something that literally make you have less tension, low cortisol (yes or no): ");
    scanf("%s", calmQ);
    if (strcmp(calmQ, "yes"))
    {
        emotion != sad;
        emotion != happy;
        emotion != energetic;
        emotion != romantic;
        emotion = calm;
        system("cls");
        printf(calm);
        system("timeout /t 6 >nul");
        printf(calmness);
        system("timeout /t 10>nul");
        return 0;
    }
    
    printf("Sorry, the Emotion Reader didn't find your emotion. Please try again on a different version, or a more advanced version of the Emotion Reader. If theres bug, please contact us by Github by leaving a note.\n");
    system("timeout /t 15 >nul");
    return 0;
}